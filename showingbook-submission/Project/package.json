{
  "name": "showingbook",
  "version": "1.0.0",
  "description": "CRM and viewing calendar for independent real estate agents",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "node --watch server/src/index.js",
    "db:init": "node server/scripts/db.js init",
    "db:seed": "node server/scripts/db.js seed",
    "db:reset": "node server/scripts/db.js reset",
    "test": "node --test \"server/test/*.test.js\"",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/ios": "^7.6.9"
  }
}
